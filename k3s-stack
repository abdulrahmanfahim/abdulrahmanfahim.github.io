#!/bin/bash

# ==========================================
# Abdu's Tools - Futuristic K3S & ERP Deployer
# ==========================================

# Ensure script is run as root for dependencies and K3s
if [[ $EUID -ne 0 ]]; then
   echo "This tool needs to install dependencies and configure systems. Please run as root (sudo)." 
   exit 1
fi

# --- Global Variables ---
BACKTITLE="Abdu's Futuristic Deployer"
TITLE="Abdu's Tools"

# --- Function: Install Dependencies & Fix DNS ---
setup_env() {
    echo "Checking and fixing DNS..."
    # Fix DNS if broken
    if ! ping -c 1 google.com &> /dev/null; then
        if ping -c 1 8.8.8.8 &> /dev/null; then
            echo "nameserver 8.8.8.8" >> /etc/resolv.conf
        fi
    fi

    echo "Installing essential dependencies..."

    # Install dependencies based on OS
    if command -v apt-get &> /dev/null; then
        apt-get update -y > /dev/null 2>&1
        apt-get install -y curl git vim whiptail sshpass > /dev/null 2>&1
    elif command -v yum &> /dev/null; then
        yum install -y epel-release > /dev/null 2>&1
        yum install -y curl git vim whiptail sshpass > /dev/null 2>&1
    elif command -v pacman &> /dev/null 2>&1; then 
	continue
    else
        echo "Unsupported package manager. Exiting."
        exit 1
    fi
}

# --- Function: Install K3S ---
install_k3s() {
    NODE_TYPE=$(whiptail --backtitle "$BACKTITLE" --title "K3S Installation" \
        --menu "Select Node Type:" 15 60 2 \
        "1" "Master Node" \
        "2" "Worker Node" \
        3>&1 1>&2 2>&3)

    if [ -z "$NODE_TYPE" ]; then return; fi

    if [ "$NODE_TYPE" -eq 1 ]; then
        TRAEFIK_CHOICE=$(whiptail --backtitle "$BACKTITLE" --title "Ingress Controller" \
            --yesno "Do you want to install Traefik with K3s?" 7 50 \
            3>&1 1>&2 2>&3)
        
        echo "Installing K3s Master Node..."
        if [ $? -eq 0 ]; then
            curl -sfL https://get.k3s.io | sh -
        else
            curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh -
        fi
        
        IP=$(hostname -I | awk '{print $1}')
        TOKEN=$(cat /var/lib/rancher/k3s/server/node-token)
        whiptail --backtitle "$BACKTITLE" --title "Success!" \
            --msgbox "Master Node Installed!\n\nServer IP: $IP\nNode Token: $TOKEN\n\nKeep this token safe! You need it for worker nodes." 12 60

    elif [ "$NODE_TYPE" -eq 2 ]; then
        MASTER_IP=$(whiptail --backtitle "$BACKTITLE" --title "Master IP" --inputbox "Enter Master Node IP:" 8 40 3>&1 1>&2 2>&3)
        TOKEN=$(whiptail --backtitle "$BACKTITLE" --title "Node Token" --inputbox "Enter Master Node Token:" 8 60 3>&1 1>&2 2>&3)
        
        echo "Installing K3s Worker Node..."
        curl -sfL https://get.k3s.io | K3S_URL="https://$MASTER_IP:6443" K3S_TOKEN="$TOKEN" sh -
        
        whiptail --backtitle "$BACKTITLE" --title "Success!" --msgbox "Worker Node Installed and joined to $MASTER_IP!" 6 50
    fi
}

# --- Function: Install ERP Stack ---
install_erp_stack() {
    MASTER_IP=$(whiptail --backtitle "$BACKTITLE" --title "SSH IP" --inputbox "Enter Master Node IP:" 8 40 3>&1 1>&2 2>&3)
    MASTER_USER=$(whiptail --backtitle "$BACKTITLE" --title "SSH User" --inputbox "Enter Master Node SSH Username:" 8 40 "root" 3>&1 1>&2 2>&3)
    MASTER_PASS=$(whiptail --backtitle "$BACKTITLE" --title "SSH Password" --passwordbox "Enter Master Node SSH Password:" 8 40 3>&1 1>&2 2>&3)
    PG_PASS=$(whiptail --backtitle "$BACKTITLE" --title "Database" --passwordbox "Setup a Password for PostgreSQL:" 8 40 3>&1 1>&2 2>&3)
    DNS_NAME=$(whiptail --backtitle "$BACKTITLE" --title "Ingress Host" --inputbox "Enter DNS Hostname (e.g., erp.local):" 8 40 3>&1 1>&2 2>&3)

    if [ -z "$MASTER_IP" ] || [ -z "$PG_PASS" ]; then return; fi

    echo "Deploying ERP Stack to $MASTER_IP..."
    export SSHPASS=$MASTER_PASS
    sshpass -e ssh -o StrictHostKeyChecking=no $MASTER_USER@$MASTER_IP << EOF
        # 1. Update /etc/hosts
        echo "127.0.0.1 $DNS_NAME" >> /etc/hosts
        
        # 2. Install Helm
        curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
        chmod 700 get_helm.sh
        ./get_helm.sh

        # 3. Add Helm Repositories
        export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
        helm repo add bitnami https://charts.bitnami.com/bitnami
        helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
        helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
        helm repo update

        # 4. Install Ingress-NGINX
        helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx

        # 5. Install PostgreSQL
        helm upgrade --install erp-db bitnami/postgresql \
            --set auth.postgresPassword=$PG_PASS \
            --set auth.database=odoo

        # 6. Calculate Nodes and Install Odoo
        NODE_COUNT=\$(kubectl get nodes --no-headers | wc -l)
        helm upgrade --install erp-odoo bitnami/odoo \
            --set postgresql.enabled=false \
            --set externalDatabase.host=erp-db-postgresql \
            --set externalDatabase.user=postgres \
            --set externalDatabase.password=$PG_PASS \
            --set externalDatabase.database=odoo \
            --set replicaCount=\$NODE_COUNT \
            --set ingress.enabled=true \
            --set ingress.hostname=$DNS_NAME

        # 7. Install Prometheus, Grafana, and Exporters
        helm upgrade --install monitoring prometheus-community/kube-prometheus-stack
        helm upgrade --install pg-exporter prometheus-community/prometheus-postgres-exporter \
            --set config.datasource.password=$PG_PASS \
            --set config.datasource.user=postgres \
            --set config.datasource.host=erp-db-postgresql
EOF

    whiptail --backtitle "$BACKTITLE" --title "Success!" \
        --msgbox "ERP Stack Deployed Successfully!\n\nPostgres, Odoo (\$NODE_COUNT replicas), NGINX, and Prometheus/Grafana are spinning up.\nDNS mapped to: $DNS_NAME" 10 60
}

# --- Function: Fun Menu (PS1) ---
fun_menu() {
    PS_CHOICE=$(whiptail --backtitle "$BACKTITLE" --title "Fun - Customize Prompt" \
        --menu "Choose your style:" 12 60 4 \
        "1" "Simple: (user@host)-(~/bin)->" \
        "2" "Minimal: [user@host]->" \
        "3" "Professional: Colored multiline" \
        3>&1 1>&2 2>&3)

    case $PS_CHOICE in
        1) NEW_PS1="PS1='(\u@\h)-(\w)\n-> '" ;;
         2) NEW_PS1="PS1='[\u@\h]-> '" ;;
        3) NEW_PS1="PS1='\n\[\e[1;36m\]\u@\h\[\e[0m\] \[\e[1;35m\]\W\[\e[0m\]\n\[\e[1;32m\]➜\[\e[0m\] '" ;;
        *) return ;;
    esac

    # Remove old PS1 exports and add the new one
    sed -i '/PS1=/d' ~/.bashrc
    echo "$NEW_PS1" >> ~/.bashrc

    whiptail --backtitle "$BACKTITLE" --title "Done!" \
        --msgbox "Prompt updated successfully!\n\nNote: To see the changes after exiting this tool, run:\n\nsource ~/.bashrc" 10 50
}

# --- Main Loop ---
# Ensure basic dependencies exist before loading main menu
setup_env

while true; do
    CHOICE=$(whiptail --clear --backtitle "$BACKTITLE" --title "$TITLE" \
        --menu "Select an operation:" 15 60 4 \
        "1" "Install K3S" \
        "2" "Install K3S ERP Stack (K3S Needed)" \
        "3" "Fun" \
        "4" "Exit" \
        3>&1 1>&2 2>&3)

    # Check if user pressed Cancel or Esc
    if [ $? -ne 0 ]; then
        clear
        echo "Exiting Abdu's Tools..."
        break
    fi

    case $CHOICE in
        1) install_k3s ;;
        2) install_erp_stack ;;
        3) fun_menu ;;
        4) 
            clear
            echo "Exiting Abdu's Tools. Have a great day!"
            break
            ;;
    esac
done
