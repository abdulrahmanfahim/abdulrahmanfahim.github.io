#!/bin/bash

export TERM=xterm

# ==========================================
# Abdu's Tools - Futuristic K3S & ERP Deployer
# ==========================================

if [[ $EUID -ne 0 ]]; then
   echo "Please run as root (sudo)."
   exit 1
fi

BACKTITLE="Abdu's Futuristic Deployer"
TITLE="Abdu's Tools"

# --- Install dialog if missing ---
if ! command -v dialog &>/dev/null; then
    apt update -y >/dev/null 2>&1
    apt install -y dialog >/dev/null 2>&1
fi

# --- Gateway Configuration ---
configure_gateway() {

    GATEWAY=$(dialog --clear \
        --backtitle "$BACKTITLE" \
        --title "Network Configuration" \
        --inputbox "Enter your IPv4 Gateway\nExample: 192.168.1.1" \
        8 50 \
        3>&1 1>&2 2>&3)

    clear

    if [ -z "$GATEWAY" ]; then
        echo "Gateway required. Exiting."
        exit 1
    fi

    ip route del default 2>/dev/null
    ip route add default via "$GATEWAY"

    sleep 2

    if ! curl -4 -I https://github.com --max-time 10 &>/dev/null; then
        dialog --title "Network Error" \
               --msgbox "IPv4 connectivity failed.\nCheck gateway/firewall." 7 50
        clear
        exit 1
    fi

    dialog --title "Success" \
           --msgbox "Gateway configured successfully!" 6 40
    clear
}

# --- Install Dependencies ---
setup_env() {

    if command -v apt-get &>/dev/null; then
        apt update -y >/dev/null 2>&1
        apt install -y curl git vim sshpass netcat-openbsd >/dev/null 2>&1
    fi
}

# --- Install K3S ---
install_k3s() {

    NODE_TYPE=$(dialog --clear \
        --backtitle "$BACKTITLE" \
        --title "K3S Installation" \
        --menu "Select Node Type:" \
        15 60 2 \
        1 "Master Node" \
        2 "Worker Node" \
        3>&1 1>&2 2>&3)

    clear
    [ -z "$NODE_TYPE" ] && return

    if [ "$NODE_TYPE" -eq 1 ]; then

        dialog --yesno "Install Traefik?" 7 40
        TRAEFIK=$?

        echo "Installing K3s Master..."

        if [ $TRAEFIK -eq 0 ]; then
            curl -4 -sfL https://get.k3s.io | sh -
        else
            curl -4 -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh -
        fi

        IP=$(hostname -I | awk '{print $1}')
        TOKEN=$(cat /var/lib/rancher/k3s/server/node-token)

        dialog --msgbox "Master Installed!\n\nIP: $IP\nToken: $TOKEN" 12 60
        clear

    else

        MASTER_IP=$(dialog --inputbox "Enter Master IP:" 8 40 3>&1 1>&2 2>&3)
        MASTER_TOKEN=$(dialog --inputbox "Enter Master Token:" 8 60 3>&1 1>&2 2>&3)
        clear

        curl -4 -sfL https://get.k3s.io | \
        K3S_URL="https://$MASTER_IP:6443" \
        K3S_TOKEN="$MASTER_TOKEN" sh -

        dialog --msgbox "Worker joined successfully!" 6 40
        clear
    fi
}

# --- Install ERP Stack ---
install_erp_stack() {

    MASTER_IP=$(dialog --inputbox "Master IP:" 8 40 3>&1 1>&2 2>&3)
    MASTER_USER=$(dialog --inputbox "SSH User:" 8 40 "root" 3>&1 1>&2 2>&3)
    MASTER_PASS=$(dialog --passwordbox "SSH Password:" 8 40 3>&1 1>&2 2>&3)
    PG_PASS=$(dialog --passwordbox "PostgreSQL Password:" 8 40 3>&1 1>&2 2>&3)
    DNS_NAME=$(dialog --inputbox "DNS Hostname (erp.local):" 8 40 3>&1 1>&2 2>&3)

    clear

    export SSHPASS=$MASTER_PASS

sshpass -e ssh -o StrictHostKeyChecking=no $MASTER_USER@$MASTER_IP << EOF

echo "127.0.0.1 $DNS_NAME" >> /etc/hosts

curl -4 -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
chmod 700 get_helm.sh
./get_helm.sh

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

helm repo add bitnami https://charts.bitnami.com/bitnami
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
helm repo update

helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx

helm upgrade --install erp-db bitnami/postgresql \
  --set auth.postgresPassword=$PG_PASS \
  --set auth.database=odoo

NODE_COUNT=\$(kubectl get nodes --no-headers | wc -l)

helm upgrade --install erp-odoo bitnami/odoo \
  --set postgresql.enabled=false \
  --set externalDatabase.host=erp-db-postgresql \
  --set externalDatabase.user=postgres \
  --set externalDatabase.password=$PG_PASS \
  --set externalDatabase.database=odoo \
  --set replicaCount=\$NODE_COUNT \
  --set ingress.enabled=true \
  --set ingress.hostname=$DNS_NAME

helm upgrade --install monitoring prometheus-community/kube-prometheus-stack

EOF

    dialog --msgbox "ERP Stack deployed successfully!" 8 50
    clear
}

# --- Main ---
configure_gateway
setup_env

while true; do
    CHOICE=$(dialog --clear \
        --backtitle "$BACKTITLE" \
        --title "$TITLE" \
        --menu "Select an operation:" \
        15 60 3 \
        1 "Install K3S" \
        2 "Install ERP Stack" \
        3 "Exit" \
        3>&1 1>&2 2>&3)

    clear
    [ $? -ne 0 ] && break

    case $CHOICE in
        1) install_k3s ;;
        2) install_erp_stack ;;
        3) break ;;
    esac
done

clear
echo "Exiting Abdu's Tools."
