#!/bin/bash

# ==========================================
# Abdu's Tools - Futuristic K3S & ERP Deployer
# ==========================================

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
   echo "Please run as root (sudo)."
   exit 1
fi

BACKTITLE="Abdu's Futuristic Deployer"
TITLE="Abdu's Tools"

# --- Function: Force Gateway Setup ---
configure_gateway() {
    GATEWAY=$(whiptail --backtitle "$BACKTITLE" --title "Network Configuration" \
        --inputbox "Enter your IPv4 Gateway (example: 192.168.1.1)" 8 50 3>&1 1>&2 2>&3)

    if [ -z "$GATEWAY" ]; then
        echo "Gateway is required. Exiting."
        exit 1
    fi

    echo "Configuring default route via $GATEWAY ..."
    
    # Remove existing default route
    ip route del default 2>/dev/null

    # Add new default route
    ip route add default via $GATEWAY

    sleep 2

    echo "Testing IPv4 connectivity..."
    if ! curl -4 -I https://github.com --max-time 10 &>/dev/null; then
        whiptail --backtitle "$BACKTITLE" --title "Network Error" \
            --msgbox "IPv4 connectivity failed.\nPlease verify your gateway and firewall." 8 50
        exit 1
    fi

    whiptail --backtitle "$BACKTITLE" --title "Success" \
        --msgbox "IPv4 network configured successfully!" 8 40
}

# --- Function: Install Dependencies ---
setup_env() {
    echo "Installing dependencies..."

    if command -v apt-get &> /dev/null; then
        apt-get update -y > /dev/null 2>&1
        apt-get install -y curl git vim whiptail sshpass netcat-openbsd > /dev/null 2>&1
    elif command -v yum &> /dev/null; then
        yum install -y epel-release > /dev/null 2>&1
        yum install -y curl git vim whiptail sshpass nc > /dev/null 2>&1
    else
        echo "Unsupported package manager."
        exit 1
    fi
}

# --- Function: Install K3S ---
install_k3s() {

    NODE_TYPE=$(whiptail --backtitle "$BACKTITLE" --title "K3S Installation" \
        --menu "Select Node Type:" 15 60 2 \
        "1" "Master Node" \
        "2" "Worker Node" \
        3>&1 1>&2 2>&3)

    [ -z "$NODE_TYPE" ] && return

    if [ "$NODE_TYPE" -eq 1 ]; then

        TRAEFIK_CHOICE=$(whiptail --backtitle "$BACKTITLE" --title "Ingress Controller" \
            --yesno "Install Traefik?" 7 50 3>&1 1>&2 2>&3)

        echo "Installing K3s Master..."

        if [ $? -eq 0 ]; then
            curl -4 -sfL https://get.k3s.io | sh -
        else
            curl -4 -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh -
        fi

        IP=$(hostname -I | awk '{print $1}')
        TOKEN=$(cat /var/lib/rancher/k3s/server/node-token)

        whiptail --backtitle "$BACKTITLE" --title "Success" \
            --msgbox "Master Installed!\n\nIP: $IP\nToken: $TOKEN" 12 60

    else
        MASTER_IP=$(whiptail --inputbox "Enter Master IP:" 8 40 3>&1 1>&2 2>&3)
        TOKEN=$(whiptail --inputbox "Enter Master Token:" 8 60 3>&1 1>&2 2>&3)

        echo "Installing Worker..."
        curl -4 -sfL https://get.k3s.io | \
        K3S_URL="https://$MASTER_IP:6443" \
        K3S_TOKEN="$TOKEN" sh -

        whiptail --msgbox "Worker joined successfully!" 6 40
    fi
}

# --- Function: Install ERP Stack ---
install_erp_stack() {

    MASTER_IP=$(whiptail --inputbox "Master IP:" 8 40 3>&1 1>&2 2>&3)
    MASTER_USER=$(whiptail --inputbox "SSH User:" 8 40 "root" 3>&1 1>&2 2>&3)
    MASTER_PASS=$(whiptail --passwordbox "SSH Password:" 8 40 3>&1 1>&2 2>&3)
    PG_PASS=$(whiptail --passwordbox "PostgreSQL Password:" 8 40 3>&1 1>&2 2>&3)
    DNS_NAME=$(whiptail --inputbox "DNS Hostname (erp.local):" 8 40 3>&1 1>&2 2>&3)

    export SSHPASS=$MASTER_PASS

sshpass -e ssh -o StrictHostKeyChecking=no $MASTER_USER@$MASTER_IP << EOF

echo "127.0.0.1 $DNS_NAME" >> /etc/hosts

curl -4 -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
chmod 700 get_helm.sh
./get_helm.sh

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

helm repo add bitnami https://charts.bitnami.com/bitnami
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
helm repo update

helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx

helm upgrade --install erp-db bitnami/postgresql \
  --set auth.postgresPassword=$PG_PASS \
  --set auth.database=odoo

NODE_COUNT=\$(kubectl get nodes --no-headers | wc -l)

helm upgrade --install erp-odoo bitnami/odoo \
  --set postgresql.enabled=false \
  --set externalDatabase.host=erp-db-postgresql \
  --set externalDatabase.user=postgres \
  --set externalDatabase.password=$PG_PASS \
  --set externalDatabase.database=odoo \
  --set replicaCount=\$NODE_COUNT \
  --set ingress.enabled=true \
  --set ingress.hostname=$DNS_NAME

helm upgrade --install monitoring prometheus-community/kube-prometheus-stack

EOF

    whiptail --msgbox "ERP Stack deployed successfully!" 8 50
}

# --- Main Execution ---

configure_gateway
setup_env

while true; do
    CHOICE=$(whiptail --menu "Select an operation:" 15 60 4 \
        "1" "Install K3S" \
        "2" "Install ERP Stack" \
        "3" "Exit" \
        3>&1 1>&2 2>&3)

    [ $? -ne 0 ] && break

    case $CHOICE in
        1) install_k3s ;;
        2) install_erp_stack ;;
        3) break ;;
    esac
done

clear
echo "Exiting Abdu's Tools."
