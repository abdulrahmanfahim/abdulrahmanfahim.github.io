#!/bin/bash
export TERM=xterm

# ==========================================
# Abdu's Tools - Futuristic K3S & ERP Deployer
# ==========================================
if [[ $EUID -ne 0 ]]; then
    echo "Please run as root (sudo)."
    exit 1
fi

BACKTITLE="Abdu's Futuristic Deployer"
TITLE="Abdu's Tools"
ENV_FILE="/etc/abdu_env"

# ------------------------------
# Persistent environment file
# ------------------------------
if [ ! -f "$ENV_FILE" ]; then
    echo "GATEWAY_CONFIGURED=0" > "$ENV_FILE"
fi
source "$ENV_FILE"

# ------------------------------
# Ensure dialog is installed
# ------------------------------
if ! command -v dialog &>/dev/null; then
    apt update -y >/dev/null 2>&1
    apt install -y dialog >/dev/null 2>&1
fi

# ------------------------------
# Ask for sudo password once
# ------------------------------
SUDO_PASS=$(dialog --clear --backtitle "$BACKTITLE" --title "Sudo Password" \
    --passwordbox "Enter your sudo password (temporarily stored):" 8 50 \
    3>&1 1>&2 2>&3)
clear
export SUDO_PASS

# Helper function for sudo with password
run_sudo() {
    echo "$SUDO_PASS" | sudo -S "$@"
}

# ------------------------------
# Configure Gateway (Only Once)
# ------------------------------
configure_gateway() {
    source "$ENV_FILE"
    if [ "$GATEWAY_CONFIGURED" -eq 1 ]; then return; fi

    GATEWAY=$(dialog --clear --backtitle "$BACKTITLE" --title "Network Configuration" \
        --inputbox "Enter your IPv4 Gateway\nExample: 192.168.1.1" 8 50 \
        3>&1 1>&2 2>&3)
    clear

    [ -z "$GATEWAY" ] && { echo "Gateway required. Exiting."; exit 1; }

    run_sudo ip route del default 2>/dev/null
    run_sudo ip route add default via "$GATEWAY"

    # Simple spinner animation for connectivity check
    (
        for i in {1..5}; do
            echo "# Testing connectivity to github.com..."
            sleep 1
        done
    ) | dialog --title "Network Check" --gauge "Checking connectivity..." 7 60 0
    clear

    if ! curl -4 -I https://github.com --max-time 10 &>/dev/null; then
        dialog --title "Network Error" --msgbox "IPv4 connectivity failed.\nCheck gateway/firewall." 7 50
        clear
        exit 1
    fi

    echo "GATEWAY_CONFIGURED=1" > "$ENV_FILE"
    dialog --title "Success" --msgbox "Gateway configured successfully!" 6 40
    clear
}

# ------------------------------
# Install Dependencies
# ------------------------------
setup_env() {
    run_sudo apt update -y >/dev/null 2>&1
    run_sudo apt install -y curl git vim sshpass netcat-openbsd >/dev/null 2>&1
}

# ------------------------------
# Animated spinner
# ------------------------------
spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while kill -0 $pid 2>/dev/null; do
        for i in $(seq 0 3); do
            printf "\r${spinstr:i:1}"
            sleep $delay
        done
    done
    printf "\r"
}

# ------------------------------
# Install K3S
# ------------------------------
install_k3s() {
    NODE_TYPE=$(dialog --clear --backtitle "$BACKTITLE" --title "K3S Installation" \
        --menu "Select Node Type:" 15 60 2 1 "Master Node" 2 "Worker Node" 3>&1 1>&2 2>&3)
    clear
    [ -z "$NODE_TYPE" ] && return

    if [ "$NODE_TYPE" -eq 1 ]; then
        dialog --yesno "Install Traefik?" 7 40
        TRAEFIK=$?

        echo "Installing K3s Master..."
        if [ $TRAEFIK -eq 0 ]; then
            curl -4 -sfL https://get.k3s.io | sh - & spinner $!
        else
            curl -4 -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable traefik" sh - & spinner $!
        fi

        IP=$(hostname -I | awk '{print $1}')
        TOKEN=$(cat /var/lib/rancher/k3s/server/node-token)
        dialog --msgbox "Master Installed!\n\nIP: $IP\nToken: $TOKEN" 12 60
        clear
    else
        MASTER_IP=$(dialog --inputbox "Enter Master IP:" 8 40 3>&1 1>&2 2>&3)
        MASTER_TOKEN=$(dialog --inputbox "Enter Master Token:" 8 60 3>&1 1>&2 2>&3)
        clear

        curl -4 -sfL https://get.k3s.io | K3S_URL="https://$MASTER_IP:6443" K3S_TOKEN="$MASTER_TOKEN" sh - & spinner $!

        dialog --msgbox "Worker joined successfully!" 6 40
        clear
    fi
}

# ------------------------------
# Install ERP Stack
# ------------------------------
install_erp_stack() {
    MASTER_IP=$(dialog --inputbox "Master IP:" 8 40 3>&1 1>&2 2>&3)
    MASTER_USER=$(dialog --inputbox "SSH User:" 8 40 "root" 3>&1 1>&2 2>&3)
    MASTER_PASS=$(dialog --passwordbox "SSH Password:" 8 40 3>&1 1>&2 2>&3)
    PG_PASS=$(dialog --passwordbox "PostgreSQL Password:" 8 40 3>&1 1>&2 2>&3)
    DNS_NAME=$(dialog --inputbox "DNS Hostname (erp.local):" 8 40 3>&1 1>&2 2>&3)
    clear

    export SSHPASS=$MASTER_PASS

    sshpass -e ssh -o StrictHostKeyChecking=no $MASTER_USER@$MASTER_IP << EOF
echo "127.0.0.1 $DNS_NAME" >> /etc/hosts
curl -4 -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
chmod 700 get_helm.sh
./get_helm.sh
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
helm repo add bitnami https://charts.bitnami.com/bitnami
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
helm repo update
helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx
helm upgrade --install erp-db bitnami/postgresql --set auth.postgresPassword=$PG_PASS --set auth.database=odoo
NODE_COUNT=\$(kubectl get nodes --no-headers | wc -l)
helm upgrade --install erp-odoo bitnami/odoo --set postgresql.enabled=false --set externalDatabase.host=erp-db-postgresql --set externalDatabase.user=postgres --set externalDatabase.password=$PG_PASS --set externalDatabase.database=odoo --set replicaCount=\$NODE_COUNT --set ingress.enabled=true --set ingress.hostname=$DNS_NAME
helm upgrade --install monitoring prometheus-community/kube-prometheus-stack
EOF

    dialog --msgbox "ERP Stack deployed successfully!" 8 50
    clear
}

# ------------------------------
# MAIN
# ------------------------------
configure_gateway
setup_env

while true; do
    CHOICE=$(dialog --clear --backtitle "$BACKTITLE" --title "$TITLE" \
        --menu "Select an operation:" 15 60 4 \
        1 "Install K3S" \
        2 "Install ERP Stack" \
        3 "Exit" \
        3>&1 1>&2 2>&3)
    clear
    [ $? -ne 0 ] && break

    case $CHOICE in
        1) install_k3s ;;
        2) install_erp_stack ;;
        3) break ;;
    esac
done

# ------------------------------
# Clean up sudo password
# ------------------------------
unset SUDO_PASS
clear
echo "Exiting Abdu's Tools."
